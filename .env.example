# Copy to .env (git-ignored) and fill in your key. Never commit real keys.

# Google Gemini API key — create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides
# GEMINI_MODEL=gemini-3.5-flash-lite      # used for both image reading and answers
# GEMINI_REASONING_EFFORT=low             # low = fast; empty = model default
# LEGALRAG_CAPTION_WITH_VLM=1             # describe tables/stamps/signatures/figures at ingest
# LEGALRAG_ANSWER_WITH_IMAGES=1           # attach retrieved crops to the question
# LEGALRAG_DATA_DIR=data/store
